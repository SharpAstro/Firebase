<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- The library itself has NO package dependencies: HttpClient, System.Text.Json's DOM and
       JsonEncodedText all ship in the shared framework. Keep it that way; an AOT-clean consumer
       (tianwen, chess's Android head) should pay nothing for using this. -->
  <ItemGroup>
    <!-- Test stack. xunit.v3 4.x runs on Microsoft.Testing.Platform (global.json opts dotnet test in). -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>
</Project>
